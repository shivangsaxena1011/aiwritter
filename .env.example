# =============================================================================
# AI Book Writer v3.0 — Environment Configuration Template
# =============================================================================
# Copy this file to .env and adjust variables for your target deployment environment.
# Mode A (Local): SQLite database, in-process worker, local disk storage.
# Mode B (Production): PostgreSQL database, Redis worker queue, Cloud storage.
# =============================================================================

# --- Application Core ---
APP_NAME="AI Book Writer"
APP_VERSION="3.0.0"
APP_ENV="production"                      # development | production | testing
DEBUG=false
HOST="0.0.0.0"
PORT=8000
SECRET_KEY="change-me-to-a-secure-random-secret-key-in-production"

# --- AI Provider Configuration ---
# Options: "gemini" (production with Google Gemini API) | "mock" (offline testing)
AI_MODE="gemini"
GEMINI_API_KEY=""                         # Server-wide Gemini API Key (optional if client provides it)
TEXT_MODEL="gemini-2.5-flash"             # gemini-2.5-flash | gemini-2.5-pro
FALLBACK_TEXT_MODEL="gemini-2.5-pro"
IMAGE_MODEL="imagen-3.0-generate-002"

# --- Database Configuration ---
# Mode A (Default): SQLite file in data directory
DATABASE_URL="sqlite:///./data/aiwriter.db"

# Mode B (PostgreSQL for Render / Supabase / Neon):
# DATABASE_URL="postgresql+psycopg2://user:password@host:5432/aiwriter"

# --- Redis & Distributed Queue (Mode B) ---
# Set REDIS_URL to enable Redis-backed queue distribution across workers
# REDIS_URL="redis://localhost:6379/0"

# --- Worker & Concurrency Limits ---
MAX_CONCURRENT_JOBS=2                    # Simultaneous generation jobs
MAX_RETRIES=3                            # Retry count for transient AI errors
RETRY_DELAY_SECONDS=2                    # Initial exponential backoff delay

# --- Storage Engine ---
# Options: "local" (default filesystem) | "s3" (AWS / MinIO) | "gcs" (Google Cloud Storage)
STORAGE_TYPE="local"
STORAGE_LOCAL_DIR="./output"

# S3 Configuration (only if STORAGE_TYPE="s3")
# S3_BUCKET_NAME="ai-textbooks"
# S3_ENDPOINT_URL=""                     # Custom endpoint for MinIO / Cloudflare R2
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION="us-east-1"

# --- CORS Settings ---
# Comma-separated list of allowed origins or "*" for development
CORS_ORIGINS="*"
